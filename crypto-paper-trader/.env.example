# Copy this file to .env and fill in what you have. Everything is optional
# except SEC_CONTACT_EMAIL, which the SEC requires before it serves filings.

# Your email. Sent only to sec.gov, in the User-Agent header the SEC requires.
SEC_CONTACT_EMAIL=

# Alpaca market data (optional, raises rate limits and enables news).
# Use keys from a PAPER account. They start with "PK". The app refuses to
# start if it sees a live-account key (starts with "AK").
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# CoinGecko Demo API key (optional, free): coin supply and market cap.
COINGECKO_DEMO_API_KEY=

# Claude API key (optional). Only needed if you pick Claude as the AI engine.
ANTHROPIC_API_KEY=

# Ollama address (optional). Only needed if you pick a local model.
OLLAMA_URL=http://127.0.0.1:11434

# Port for the app. The app always listens on 127.0.0.1 only.
PORT=8765
