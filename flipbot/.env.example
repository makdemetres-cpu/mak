# FlipDesk secrets
# ---------------------------------------------------------------------------
# start.bat copies this file to ".env" (same folder) the first time it runs.
# Fill in .env, NOT this file. .env never leaves your PC: it is git-ignored, so
# GitHub Desktop will never show or upload it.
# Write each value straight after the "=" with no spaces and no quotes.
# Leave a line empty if you don't have that key yet; the matching feature stays off.
# After editing .env, run stop.bat and then start.bat so the bot reloads it.

# Telegram bot token from @BotFather (looks like 123456789:AAH...).
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID from @userinfobot (e.g. 123456789).
# The bot answers ONLY these IDs. Separate several with commas: 111,222
TELEGRAM_ALLOWED_USER_IDS=

# Claude API key from console.anthropic.com (starts with sk-ant-).
# Spending is capped by ai.monthly_budget_usd in config.yaml (default $10).
ANTHROPIC_API_KEY=

# OpenRouteService API key from openrouteservice.org (free plan).
# Used only to compute driving times from your base location.
OPENROUTESERVICE_API_KEY=
