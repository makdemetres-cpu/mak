# ─────────────────────────────────────────────────────────────────────────────
# MAKIS — copy this file to `.env` and fill in the keys you have.
# With NO keys at all the app still runs in browser mode (Chrome/Edge only,
# robotic voice) so you can try the whole flow before signing up anywhere.
# `npm run doctor` tells you exactly what is working and what is not.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000

# ── Speech to text ───────────────────────────────────────────────────────────
# groq | browser
STT_PROVIDER=groq
# console.groq.com -> API Keys. Free, no credit card.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── The brain (and the coach) ────────────────────────────────────────────────
# gemini | groq
LLM_PROVIDER=gemini
# aistudio.google.com -> Get API key. Free, no credit card.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Only needed if LLM_PROVIDER=groq (uses GROQ_API_KEY above)
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── The voice ────────────────────────────────────────────────────────────────
# gemini | google | elevenlabs | browser
#
#   gemini  — no card, no extra account: reuses GEMINI_API_KEY above.
#             Small daily quota; falls back to the browser voice when spent.
#   google  — the best free Greek voice (Chirp 3 HD, 1M chars/month free),
#             but Google Cloud requires a card on file to serve it at all.
TTS_PROVIDER=gemini

# --- Option A: Gemini voice (no card) ---------------------------------------
# Uses GEMINI_API_KEY from above. Run `npm run doctor` to confirm the model name.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
# Plain-language direction for how he should sound.
GEMINI_TTS_STYLE=Πες το με βαριεστημένη, βιαστική φωνή ενός μεσήλικα Έλληνα καταστηματάρχη στο τηλέφωνο

# --- Option B: Google Cloud Chirp 3 HD (needs a card, stays free) -----------
# Google Cloud -> enable "Cloud Text-to-Speech API" -> Credentials -> API key.
# 1 million characters/month free on Chirp 3: HD.
GOOGLE_TTS_API_KEY=
# Run `npm run voices` to hear the options and pick one.
GOOGLE_TTS_VOICE=el-GR-Chirp3-HD-Charon
GOOGLE_TTS_SPEAKING_RATE=1.0

# Optional: the most human Greek voice, but the free plan is ~10 min/month.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
