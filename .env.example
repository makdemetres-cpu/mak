# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# ── Database (Supabase Postgres) ────────────────────────────────────────
# Connection string from your Supabase project (Settings → Database).
# Use the pooled "Transaction" connection string for DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# ── Admin dashboard (/admin) ─────────────────────────────────────────────
# The password for the single admin login. Choose something long and
# unique — this is the only thing standing between the public internet
# and your customers' booking data.
ADMIN_PASSWORD=""
# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────
# API key from resend.com. Without this set, booking emails are skipped
# (bookings still save to the database) and a warning is logged.
RESEND_API_KEY=""
# Must be an address on a domain verified with Resend — Resend cannot
# send "from" @gmail.com or any domain you haven't verified.
BOOKING_FROM_EMAIL="bookings@hydrocore.gr"
# Where new-booking notifications are sent. This can be a plain inbox
# (e.g. Gmail) — only the FROM address needs domain verification.
BOOKING_NOTIFY_EMAIL="maktheplumber@gmail.com"

# ── Photo uploads (Supabase Storage) ─────────────────────────────────────
# Same Supabase project as DATABASE_URL. Use the Service Role key (never
# the anon/public key) — this is server-only and must stay secret.
# Without these set, photo uploads are validated but not stored (booking
# still succeeds, a warning is logged).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────
# From your Upstash Redis database (REST API section). Without these set,
# the booking endpoint is NOT rate-limited — fine for local development,
# required before production launch.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
